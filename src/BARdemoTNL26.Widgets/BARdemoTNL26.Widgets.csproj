<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>BrianRandell.Demo.TechoramaNL26.Widgets</PackageId>
    <Version>1.0.0</Version>
    <Authors>Brian Randell</Authors>
    <Description>Demo package for the Techorama NL 2026 session "Your Pipeline Is the Target". Not for production use.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/devopsfm/BARdemoTNL26.Widgets</PackageProjectUrl>
    <RepositoryUrl>https://github.com/devopsfm/BARdemoTNL26.Widgets</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
